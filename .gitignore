*.raw
*.log
*.vcd
*.vvp
__pycache__/
.DS_Store

# sim/ harness: per-corner ngspice logs under corners/ are committed evidence
# (append-only record trail), so they escape the *.log rule.
!sim/*/corners/**/*.log
sim/build/
# settling-bench scratch: per-variant partial results and the raw klt
# report / batch receipt kept for debugging a failed or partial grid
sim/*/.partials/
sim/*/.artifacts/
# probe scratch: single-corner request copies the runners write beside the
# request file and delete again (left behind only if a probe crashes)
sim/*/probe_request_*.json
sim/*/.selftest*
sim/*/.probe_step_*
# synthesis / P&R scratch
flow/build/
# klt synthesize per-run scratch next to the request file
verification/smoke/.klt/
verification/decimator/.klt/
layout/digital/.klt/
# local klt install, created by the setup script
.venv/
